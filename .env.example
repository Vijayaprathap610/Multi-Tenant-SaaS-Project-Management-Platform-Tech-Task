# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=techtask
POSTGRES_USER=techtask
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Origins trusted for CSRF checks (same-origin deployment: no CORS headers are sent)
TRUSTED_ORIGINS=http://localhost:5173
# Used only by `manage.py create_platform_admin` (otherwise you are prompted)
PLATFORM_ADMIN_PASSWORD=
# Stripe (test mode only) - added in Phase 5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Tech Task <no-reply@techtask.local>
MEDIA_ROOT=/app/media
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_SCAN_COMMAND=
NOTIFY_BY_EMAIL=true
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_ALLOW_HTTP=false
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
